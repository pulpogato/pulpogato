{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "dependencyDashboard": {"enabled": true},
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "Give consumer-facing framework releases time to settle without blocking patches behind baseline upgrades",
      "matchDatasources": ["maven"],
      "matchPackageNames": [
        "org.springframework*:*",
        "io.projectreactor*:*",
        "io.micrometer*:*",
        "com.fasterxml.jackson*:*",
        "tools.jackson*:*",
        "org.slf4j:*",
        "jakarta.*:*",
        "com.netflix.graphql.dgs:graphql-dgs-client",
        "com.graphql-java:graphql-java"
      ],
      "minimumReleaseAge": "14 days",
      "minimumReleaseAgeBehaviour": "timestamp-required",
      "separateMinorPatch": true
    },
    {
      "description": "Require explicit approval and review before changing consumer framework baselines",
      "matchDatasources": ["maven"],
      "matchPackageNames": [
        "org.springframework*:*",
        "io.projectreactor*:*",
        "io.micrometer*:*",
        "com.fasterxml.jackson*:*",
        "tools.jackson*:*",
        "org.slf4j:*",
        "jakarta.*:*",
        "com.netflix.graphql.dgs:graphql-dgs-client",
        "com.graphql-java:graphql-java"
      ],
      "matchUpdateTypes": ["minor", "major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/verify-lockfile\\.yml$/"],
      "matchStrings": [
        "gh extension install (?<depName>github/gh-actions-lock) --pin (?<currentValue>v[^\\s]+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "matchStrings": [
        "selectNode +v(?<currentValue>.+?)\n"
      ],
      "managerFilePatterns": [
        "/(^|/)(npmw|yarnw|nodew)$/"
      ],
      "datasourceTemplate": "node",
      "depNameTemplate": "node"
    },
    {
      "customType": "regex",
      "matchStrings": [
        "selectTool +(?<depName>[^ ]+) +(?<currentValue>.+?)\n"
      ],
      "managerFilePatterns": [
        "/(^|/)(npmw|yarnw|nodew)$/"
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
